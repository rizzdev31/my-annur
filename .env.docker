# ── Template .env untuk deploy Docker (VPS) ─────────────────────────
# Salin ke .env lalu isi nilai rahasianya:  cp .env.docker .env
# WAJIB ganti semua "GANTI-*" dengan nilai kuat.

APP_NAME="An-Nur Smart System"
APP_ENV=production
# APP_KEY: JANGAN taruh komentar di baris ini (compose membaca komentar sbg
# nilai). Biarkan kosong → deploy.sh mengisinya otomatis saat pertama kali.
APP_KEY=
APP_DEBUG=false
APP_URL=https://myannur.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Domain cookie/SPA (samakan dgn domain di atas). SESSION_DOMAIN null = otomatis.
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=myannur.id,www.myannur.id

# Password superadmin awal (email superadmin@annur.sch.id) — WAJIB diganti kuat.
SUPERADMIN_PASSWORD=GANTI-password-admin-kuat

# Log ke stdout → tampil di `docker compose logs`
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ── Database (service 'mysql' di compose ini) ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=systemdb
DB_USERNAME=annur
DB_PASSWORD=GANTI-password-db-kuat
DB_ROOT_PASSWORD=GANTI-root-db-kuat

# Driver berbasis DB (tanpa Redis) — sesuai setup sekarang
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Integrasi ke RamahAnak (lewat jaringan 'edge', nama container ra_app) ──
# TAHAP 1: RA belum di-deploy → NONAKTIF dulu supaya Smart berdiri sendiri.
# Nanti saat RA menyusul: set true + isi token (== INTEGRASI_API_TOKEN di RA).
RAMAHANAK_API_URL=http://ra_app/api/v1
RAMAHANAK_API_TOKEN=GANTI-token-integrasi-sama-dengan-RA
RAMAHANAK_APP_NAME=annur-smart-habbit
RAMAHANAK_ENABLED=false

# ── Berita dari CMS An-Nur (annur-cms) untuk banner Beranda guru ──
BERITA_CMS_URL=https://ppmannursidoarjo.com
BERITA_ENABLED=true

# Jalankan migrate otomatis saat container start (set false untuk manual)
RUN_MIGRATIONS=false
